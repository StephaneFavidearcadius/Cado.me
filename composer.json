{
    "name": "cado-me/saas",
    "description": "Cado.me - SaaS Multi-Communautés",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4",
        "vlucas/phpdotenv": "^5.6",
        "symfony/mailer": "^7.0",
        "symfony/validator": "^7.0",
        "intervention/image": "^3.0",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"copy('.env.example', '.env');\" || true"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
